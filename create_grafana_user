#!/bin/bash

#  Grafana admin credentials
read -p "Enter Grafana admin username: " ADMIN_USER
read -sp "Enter Grafana admin password: " ADMIN_PASSWORD
echo

# New user details
read -p "Enter new user's name: " NEW_USER_NAME
read -p "Enter new user's email: " NEW_USER_EMAIL
read -p "Enter new user's login: " NEW_USER_LOGIN
read -sp "Enter new user's password: " NEW_USER_PASSWORD
echo

# Grafana URL configuration
GRAFANA_URL="http://your_server_ip:3000"

# Step 1: Create the new user via the REST API
response=$(curl -s -X POST -H "Content-Type: application/json" \
    -d "{\"name\":\"${NEW_USER_NAME}\", \"email\":\"${NEW_USER_EMAIL}\", \"login\":\"${NEW_USER_LOGIN}\", \"password\":\"${NEW_USER_PASSWORD}\"}" \
    ${GRAFANA_URL}/api/admin/users \
    --user ${ADMIN_USER}:${ADMIN_PASSWORD})

# Extract the new user's id using jq (make sure jq is installed)
USER_ID=$(echo "$response" | jq '.id')

if [ -z "$USER_ID" ] || [ "$USER_ID" = "null" ]; then
    echo "Failed to create user: $response"
    exit 1
fi

echo "User created with id: $USER_ID"

# Step 2: Set the new user's role to Viewer
update_response=$(curl -s -X PUT -H "Content-Type: application/json" \
    -d '{"role": "Viewer"}' \
    ${GRAFANA_URL}/api/org/users/${USER_ID} \
    --user ${ADMIN_USER}:${ADMIN_PASSWORD})

echo "Role update response: $update_response"

